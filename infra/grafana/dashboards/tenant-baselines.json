    },
    {
      "id": 2,
      "type": "table",
      "title": "Alert log (latest 100, live)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT event_time, state, signal, key, value, reference, reason, scope, region,\n    starts_at, emitted_at, detector, setting, alert_id\nFROM tb.alert_log FINAL\nWHERE ns = 'live'\nORDER BY event_time DESC, alert_id, state\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
