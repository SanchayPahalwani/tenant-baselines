{
  "uid": "tenant-baselines",
  "title": "Tenant baselines",
  "description": "Synthetic demo data. One key's signals against their seasonal baseline, and the live alert log.",
  "tags": [
    "tenant-baselines"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "key",
        "label": "key",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT key FROM tb.aggregates WHERE ns='live' AND minute > now() - INTERVAL 1 HOUR GROUP BY key ORDER BY sum(count) DESC",
        "definition": "SELECT key FROM tb.aggregates WHERE ns='live' AND minute > now() - INTERVAL 1 HOUR GROUP BY key ORDER BY sum(count) DESC",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "signal",
        "label": "signal",
        "type": "custom",
        "query": "error_rate,latency_p95,volume_5m",
        "multi": true,
        "includeAll": false,
        "hide": 2,
        "current": {
          "text": [
            "error_rate",
            "latency_p95",
            "volume_5m"
          ],
          "value": [
            "error_rate",
            "latency_p95",
            "volume_5m"
          ]
        },
        "options": [
          {
            "text": "error_rate",
            "value": "error_rate",
            "selected": true
          },
          {
            "text": "latency_p95",
            "value": "latency_p95",
            "selected": true
          },
          {
            "text": "volume_5m",
            "value": "volume_5m",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$key: $signal with baseline band",
      "description": "The seasonal baseline of the key's hour of the week (or its region's or the global one while the key is cold). The dashed line is the median, for volume the expected 5-minute sum. The band is 4 spreads either side of it, the k4 fire level: error rate and latency fire above it, volume below it.",
      "repeat": "signal",
      "repeatDirection": "v",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, value, median, median + 4 * spread AS upper,\n       greatest(median - 4 * spread, 0) AS lower\nFROM tb.scores FINAL\nWHERE ns = 'live' AND key = '${key}' AND signal = '${signal}'\n  AND minute >= $__fromTime AND minute <= $__toTime\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "median"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "upper"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillBelowTo",
                "value": "lower"
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lower"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Alert log (latest 100, live)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT event_time, state, detector, setting, signal, key, value, reference, reason, scope,\n    region, starts_at, emitted_at, alert_id\nFROM tb.alert_log FINAL\nWHERE ns = 'live'\nORDER BY event_time DESC, alert_id, state\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
