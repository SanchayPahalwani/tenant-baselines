{
  "uid": "tenant-baselines",
  "title": "Tenant baselines",
  "description": "Synthetic demo data. One key's signals and the live alert log.",
  "tags": [
    "tenant-baselines"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "key",
        "label": "key",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT key FROM tb.aggregates WHERE ns='live' ORDER BY key",
        "definition": "SELECT DISTINCT key FROM tb.aggregates WHERE ns='live' ORDER BY key",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$key: error rate, p95 latency and 5-minute volume",
      "description": "Red dashed lines are the demo static fire levels (infra/flink/thresholds-demo.json). Volume fires at or below its line.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT time, error_rate, latency_p95, volume_5m\nFROM (\n    SELECT\n        minute AS time,\n        errors / nullIf(count, 0) AS error_rate,\n        p95_latency_ms AS latency_p95,\n        sum(count) OVER (ORDER BY toUnixTimestamp(minute) RANGE BETWEEN 240 PRECEDING AND CURRENT ROW) AS volume_5m\n    FROM tb.aggregates FINAL\n    WHERE ns = 'live' AND key = '${key}'\n        AND minute >= $__fromTime - INTERVAL 4 MINUTE AND minute <= $__toTime\n)\nWHERE time >= $__fromTime\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error_rate"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "error rate"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "custom.axisLabel",
                "value": "error rate"
              },
              {
                "id": "custom.axisSoftMin",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              },
              {
                "id": "custom.axisSoftMax",
                "value": 0.1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
